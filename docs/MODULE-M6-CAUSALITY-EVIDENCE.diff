+// ══ REPRODUKSI GAP — keadaan SEBELUM M6 ═════════════════════════════════════
+
+Deno.test('M6-REPRO-1: modul yang mengabaikan SELURUH konteks lolos sebelum M6', async () => {
+  const k = await fixtureHistoris();
