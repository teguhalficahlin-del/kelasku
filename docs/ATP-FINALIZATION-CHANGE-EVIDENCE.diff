+   *  lama yang disusun sebelum acuan CP ada. */
+  tuntutan?: string[];
+  jp_alokasi: number;
+  jp_pertemuan: number[];
+  /** 1 atau 2. Satu TP tidak boleh terbelah dua semester. */
+  semester?: number;
+  konteks?: string[];
+  tipe?: 'inti' | 'prasyarat' | 'pengayaan';
+  catatan?: string;
+};
+
+export type KeputusanMiClass = {
+  pertanyaan: string;
